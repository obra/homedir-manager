#!/bin/sh
# bootstrap — first-run setup: put homedir-manager on PATH, build the macOS helper, optional install.
set -eu
# shellcheck disable=SC1007
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

# 1. PATH: symlink the dispatcher into the first writable ~/.local/bin or /usr/local/bin.
for d in "$HOME/.local/bin" /usr/local/bin; do
  if mkdir -p "$d" 2>/dev/null && [ -w "$d" ]; then
    ln -sf "$ROOT/bin/homedir-manager" "$d/homedir-manager"
    ln -sf "$ROOT/bin/homedir-manager" "$d/hm"
    printf 'linked homedir-manager + hm into %s\n' "$d"
    break
  fi
done

# 2. macOS: build the Swift helper if the toolchain is present.
if [ "$(uname -s)" = "Darwin" ] && [ -d "$ROOT/macos" ] && command -v swift >/dev/null 2>&1; then
  printf 'building macos-defaults helper...\n'
  ( cd "$ROOT/macos" && swift build -c release )
fi

# 3. Deploy bundled skills into ~/.claude/skills so they're available to Claude. Each is
# symlinked; a pre-existing real (non-symlink) entry is left alone rather than clobbered.
if [ -d "$ROOT/skills" ]; then
  mkdir -p "$HOME/.claude/skills"
  for s in "$ROOT/skills"/*/; do
    [ -d "$s" ] || continue
    _dest="$HOME/.claude/skills/$(basename "$s")"
    if [ -e "$_dest" ] && [ ! -L "$_dest" ]; then
      printf 'skipping skill %s: exists and is not a symlink\n' "$_dest" >&2
      continue
    fi
    ln -sfn "${s%/}" "$_dest"
  done
  printf 'linked bundled skills into ~/.claude/skills\n'
fi

# 4. Install the pre-push secret-audit hook into any managed content repos already present
# (idempotent, clobber-safe; no-ops cleanly if none are found yet).
"$ROOT/bin/homedir-manager" install-hooks || true

printf 'bootstrap complete. Run: homedir-manager install\n'
