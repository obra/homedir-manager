#!/bin/sh
# homedir-manager — deploy + audit + macOS-defaults for marker-tagged content repos.
set -eu

# Resolve $0 through any symlinks so HM_LIB is correct when the binary is symlinked onto PATH.
HM_SELF=$0
while [ -L "$HM_SELF" ]; do
  HM_LINK=$(readlink "$HM_SELF")
  case $HM_LINK in
    /*) HM_SELF=$HM_LINK ;;
    *)  HM_SELF=$(dirname -- "$HM_SELF")/$HM_LINK ;;
  esac
done
# shellcheck disable=SC1007
HM_LIB=$(CDPATH= cd -- "$(dirname -- "$HM_SELF")/../lib" && pwd -P)
# shellcheck source=lib/common.sh
. "$HM_LIB/common.sh"
# shellcheck source=lib/config.sh
. "$HM_LIB/config.sh"
# shellcheck source=lib/deploy.sh
. "$HM_LIB/deploy.sh"
# shellcheck source=lib/audit.sh
. "$HM_LIB/audit.sh"
# shellcheck source=lib/defaults.sh
. "$HM_LIB/defaults.sh"
# shellcheck source=lib/hooks.sh
. "$HM_LIB/hooks.sh"

usage() {
  cat <<'EOF'
usage: homedir-manager <command> [options]

commands:
  install [--dry-run]              symlink every managed repo's manifest into $HOME
  audit [--secrets]                scan managed repos for leaks, drift, bad perms
  install-hooks                    install the pre-push secret-audit hook into managed repos
  defaults <apply|drift|capture> … macOS preferences (macOS only)
  help | --help                    this message
  version | --version              print version
EOF
}

HM_VERSION='0.1.0'

cmd=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi
case "$cmd" in
  help|--help|-h) usage ;;
  version|--version) printf '%s\n' "$HM_VERSION" ;;
  install)
    # _dryflag (not _dry): deploy_repo uses _dry internally and would clobber it across repos,
    # causing every repo after the first to deploy for real during a --dry-run.
    _dryflag=''
    [ "${1:-}" = "--dry-run" ] && _dryflag='--dry-run'
    discover_repos | while IFS= read -r repo; do
      printf '== %s ==\n' "$repo"
      deploy_repo "$repo" $_dryflag
    done
    if [ "$(discover_repos | wc -l | tr -d ' ')" = 0 ]; then
      printf 'homedir-manager: no managed repos found under %s\n' "$(hm_base)" >&2
    fi
    ;;
  audit)
    _checks='secrets drift perms'
    [ "${1:-}" = "--secrets" ] && _checks='secrets'
    audit_all '' "$_checks" || exit 1
    ;;
  install-hooks) install_hooks ;;
  defaults) defaults_cmd "$@" ;;
  *) usage; exit 2 ;;
esac
